  "MuteCommand": "mute {id} {duration} {reason}",
  "UnmuteCommand": "unmute {id}",
  "AllowGlobalChatAnnouncements": true,
  "AnnounceMutes": true,
  "MuteAnnouncement": "{name} was muted for {duration}: {reason}",
  "AnnounceUnmutes": true,
  "UnmuteAnnouncement": "{name} has been unmuted.",
