  "ChatTimeoutDuration": "10m",
  "ChatTimeoutReason": "Chat moderation",
  "ChatDeleteCommand": "",
  "ChatQuickReplies": [
    "Please keep chat respectful.",
    "Take this to a ticket if you need staff help.",
    "Stop spamming chat.",
    "That language is not allowed here."
  ],
  "ChatWordBlacklist": [],
  "UseInventoryViewerPlugin": true,
  "InventoryViewerCommand": "viewinv {id}",
  "UseGodmodeForPassive": true,
  "GodmodeCommand": "god {id}",
  "VanishCommand": "vanish",
  "SafeMode": false,
  "EnableCommandSafety": true,
  "AllowOwnerCommandSafetyBypass": false,
  "MaintenanceKickMessage": "Server maintenance is currently in progress. Please try again shortly.",
